  "evidence": [
    {
      "id": "SEG-FSG-IDENTITY",
      "source_id": "MAS-FSG-G02-2016",
      "title": "Marketing and distribution safeguards > Identity disclosure",
      "source_url": "https://www.mas.gov.sg/regulation/guidelines/guidelines-on-standards-of-conduct-for-marketing-and-distribution-activities-fsg-g02",
      "paragraph_ref": "Safeguard 6; 2.2.5-2.2.6",
      "page": 13,
      "text": "Representatives should identify themselves and their institution before prospecting, and explain relevant third-party relationships. This existing identity safeguard is distinct from the later proposal about marketing intent and consent.",
      "text_kind": "PARAPHRASE",
      "verification_status": "VERIFIED_PRIMARY_SOURCE",
      "data_origin": "PUBLIC_REGULATORY_SOURCE"
    },
    {
      "id": "SEG-FSG-GIFT",
      "source_id": "MAS-FSG-G02-2016",
      "title": "Marketing and distribution safeguards > Gifts",
      "source_url": "https://www.mas.gov.sg/regulation/guidelines/guidelines-on-standards-of-conduct-for-marketing-and-distribution-activities-fsg-g02",
      "paragraph_ref": "Safeguard 10; 2.2.17-2.2.20 (pages 16-17)",
      "page": 16,
      "text": "Financial institutions should prevent gifts and gift promotion from improperly influencing purchases. Related guidance discourages drawing customers' attention to gifts and describes approval, value limits and monitoring practices.",
      "text_kind": "PARAPHRASE",
      "verification_status": "VERIFIED_PRIMARY_SOURCE",
      "data_origin": "PUBLIC_REGULATORY_SOURCE"
    },
    {
      "id": "SEG-CP-GIFT",
      "source_id": "MAS-P002-2023",
      "title": "Proposed measures > Measure 4",
      "source_url": "https://www.mas.gov.sg/publications/consultations/2023/consultation-paper-on-enhancing-safeguards-for-prospecting-activities-at-public-places",
      "paragraph_ref": "3.21",
      "page": 11,
      "text": "MAS proposes explicitly prohibiting representatives and institutions from invoking gift offers to induce a purchase or a larger purchase.",
      "text_kind": "PARAPHRASE",
      "verification_status": "VERIFIED_PRIMARY_SOURCE",
      "data_origin": "PUBLIC_REGULATORY_SOURCE"
    },
    {
      "id": "SEG-CP-TELEMARKETING",
      "source_id": "MAS-P002-2023",
      "title": "Proposals for telemarketing",
      "source_url": "https://www.mas.gov.sg/publications/consultations/2023/consultation-paper-on-enhancing-safeguards-for-prospecting-activities-at-public-places",
      "paragraph_ref": "4.1(a)-(b); footnotes 29-30",
      "page": 15,
      "text": "The proposal applies Measures 2 and 4 to telemarketing: upfront disclosure and consent, plus protection against gift-based inducement. Identity disclosure already exists in baseline Safeguard 6.",
      "text_kind": "PARAPHRASE",
      "verification_status": "VERIFIED_PRIMARY_SOURCE",
      "data_origin": "PUBLIC_REGULATORY_SOURCE"
    },
    {
      "id": "SEG-CP-LEGAL-FORCE",
      "source_id": "MAS-P002-2023",
      "title": "Proposed measures > Measure 1",
      "source_url": "https://www.mas.gov.sg/publications/consultations/2023/consultation-paper-on-enhancing-safeguards-for-prospecting-activities-at-public-places",
      "paragraph_ref": "3.2-3.4",
      "page": 6,
      "text": "Proposed Notices cover investment products and long-term accident and health policies. Other products retain guideline treatment. This is a proposed legal-force change, not an enacted requirement.",
      "text_kind": "PARAPHRASE",
      "verification_status": "VERIFIED_PRIMARY_SOURCE",
      "data_origin": "PUBLIC_REGULATORY_SOURCE"
    },
    {
      "id": "SEG-CP-CONSENT",
      "source_id": "MAS-P002-2023",
      "title": "Proposed measures > Measure 2",
      "source_url": "https://www.mas.gov.sg/publications/consultations/2023/consultation-paper-on-enhancing-safeguards-for-prospecting-activities-at-public-places",
      "paragraph_ref": "3.8-3.9 (pages 7-8)",
      "page": 7,
      "text": "MAS proposes disclosing the marketing purpose upfront and obtaining verbal or written permission before prospecting. Registration for a scheduled event may constitute consent.",
      "text_kind": "PARAPHRASE",
      "verification_status": "VERIFIED_PRIMARY_SOURCE",
      "data_origin": "PUBLIC_REGULATORY_SOURCE"
    }
  ],
